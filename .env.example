# Copy this file to `.env` and fill in the values you have.
# `.env` is gitignored — never commit real keys.

# --- AI providers (see docs/governance/AI-PROVIDERS.md) ---
# You do NOT need all of them. Fill the ones you have; the AI layer falls back
# across whatever is configured. Minimum recommended: Groq (free, fast, no card).
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Preference order for the AI layer (comma-separated provider ids).
# Kevin (2026-08-12): ordered by QUALITY first, degrading only once a
# provider's daily quota is actually exhausted. The first available+under-quota
# provider is used; on quota/error it falls back to the next.
AI_PROVIDER_ORDER=gemini_flash,groq,gemini_flash_lite,openrouter

# --- Browser (only needed by collectors that use a real browser) ---
# On Windows these point at your Chrome; inside WSL, Claude Code will adapt.
CHROME_BROWSER_PATH=
CHROME_USER_DATA_PATH=
CHROME_PROFILE_DIRECTORY=

# --- Behaviour toggles ---
SAVE_AI_DEBUG=false
